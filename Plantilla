*{
    padding: 0;
    margin: 0;
    font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
}
.Barra{
    display: flex;
    align-items: center;
}   
.logo1{ 
    margin-top: 20px;
    margin-left: 20px;
    font-size: 2rem;
    color: #0B3D2E;
    font-weight: bold;
}
.logo2{
    color: #ffffff;
    background-color: #B3F34A;
    margin-top: 15px;
    margin-left: 10px;
    font-size: 2rem;
    padding: 2px 12px;
    border-radius: 10px;
    font-weight: bold;
}
.inicio{
    margin-top: 25px;
    margin-left: 300px;
    font-size: 30px;
    color: gray;
    text-decoration: none;
}
.canchas{
    margin-top: 25px;
